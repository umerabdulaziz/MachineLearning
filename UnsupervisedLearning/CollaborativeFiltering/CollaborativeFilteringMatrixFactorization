# Collaborative Filtering using Matrix Factorization
import pandas as pd
import numpy as np
from sklearn.metrics import mean_squared_error
from math import sqrt

# Load dataset (MovieLens 100k sample, can download from https://grouplens.org/datasets/movielens/)
# Assume ratings.csv with columns: userId, movieId, rating
ratings = pd.read_csv("ratings.csv")

# Create user-item matrix
user_item_matrix = ratings.pivot(index="userId", columns="movieId", values="rating").fillna(0)

# Matrix Factorization with SGD
class MF:
    def __init__(self, R, K=20, alpha=0.01, beta=0.01, iterations=50):
        self.R = R
        self.num_users, self.num_items = R.shape
        self.K = K
        self.alpha = alpha
        self.beta = beta
        self.iterations = iterations

    def train(self):
        # Initialize user/item latent factor matrices
        self.P = np.random.normal(scale=1./self.K, size=(self.num_users, self.K))
        self.Q = np.random.normal(scale=1./self.K, size=(self.num_items, self.K))

        # SGD training
        for it in range(self.iterations):
            for i in range(self.num_users):
                for j in range(self.num_items):
                    if self.R[i][j] > 0:
                        eij = self.R[i][j] - np.dot(self.P[i,:], self.Q[j,:].T)
                        self.P[i,:] += self.alpha * (eij * self.Q[j,:] - self.beta * self.P[i,:])
                        self.Q[j,:] += self.alpha * (eij * self.P[i,:] - self.beta * self.Q[j,:])
            # Calculate training RMSE
            rmse = self.rmse()
            print(f"Iteration: {it+1}, RMSE: {rmse:.4f}")

    def rmse(self):
        xs, ys = self.R.nonzero()
        predicted = self.full_matrix()
        error = sqrt(mean_squared_error(self.R[xs, ys], predicted[xs, ys]))
        return error

    def full_matrix(self):
        return np.dot(self.P, self.Q.T)

mf = MF(user_item_matrix.values, K=20, alpha=0.01, beta=0.01, iterations=10)
mf.train()

predicted_ratings = mf.full_matrix()
print("Predicted ratings for user 1:", predicted_ratings[0][:10])
